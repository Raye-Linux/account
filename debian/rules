#!/usr/bin/make -f
#
# The crates are not kept in git: tools/vendor.sh puts them in vendor/
# before the build, and cargo never reaches the network (--frozen).
# Only the desktop side is built here; the server is deployed on its own.

export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR = $(CURDIR)/build/target
JOBS = $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
CARGO_JOBS = $(if $(JOBS),-j$(JOBS))
QML = build/qml

%:
	dh $@

override_dh_auto_configure:
	test -d vendor || { echo "vendor/ is missing: run tools/vendor.sh"; exit 1; }
	mkdir -p $(CARGO_HOME)
	printf '%s\n' \
		'[source.crates-io]' \
		'replace-with = "vendored-sources"' \
		'[source.vendored-sources]' \
		'directory = "$(CURDIR)/vendor"' \
		'[net]' \
		'offline = true' >$(CARGO_HOME)/config.toml
	cmake -S client/qml -B $(QML) -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH)

override_dh_auto_build:
	cargo build --release --frozen $(CARGO_JOBS) -p raye-accountd
	cmake --build $(QML) $(CARGO_JOBS)

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --frozen $(CARGO_JOBS) -p raye-account-common -p raye-accountd
	ctest --test-dir $(QML) --output-on-failure
	python3 tests/test_sync_table.py
endif

override_dh_auto_install:
	install -D -m755 $(CARGO_TARGET_DIR)/release/raye-accountd debian/raye-account/usr/libexec/raye-accountd
	install -D -m644 client/data/dbus/org.raye.Account1.service debian/raye-account/usr/share/dbus-1/services/org.raye.Account1.service
	for u in client/data/systemd/*; do \
		install -D -m644 $$u debian/raye-account/usr/lib/systemd/user/$$(basename $$u); \
	done
	install -D -m644 debian/account-preview debian/raye-account/etc/raye/account-preview
	DESTDIR=$(CURDIR)/debian/qml6-module-org-raye-account cmake --install $(QML)

# The sync units are switched on by raye-accountd at sign-in and off at
# sign-out; enabling them for everyone at install would sync nobody.
override_dh_installsystemduser:

override_dh_auto_clean:
	rm -rf build debian/cargo-home

# dh_clean deletes *.orig, and every vendored crate has a Cargo.toml.orig
# that its checksum file names.
override_dh_clean:
	dh_clean -Xvendor/
