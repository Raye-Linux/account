msgctxt "@info"
msgid "Can't reach your Raye account"
msgstr "Impossible de joindre votre compte Raye"

msgctxt "@info"
msgid "Check your internet connection. Your settings sync when you're back online."
msgstr "Vérifiez votre connexion Internet. Vos paramètres se synchroniseront dès votre retour en ligne."

msgctxt "@info"
msgid "Sign in again"
msgstr "Reconnectez-vous"

msgctxt "@info"
msgid "This PC was signed out of your Raye account."
msgstr "Ce PC a été déconnecté de votre compte Raye."

msgctxt "@info"
msgid "Sign-in took too long"
msgstr "La connexion a pris trop de temps"

msgctxt "@info"
msgid "Start again when you're ready."
msgstr "Recommencez quand vous êtes prêt."

msgctxt "@info"
msgid "Couldn't keep you signed in"
msgstr "Impossible de garder votre session"

msgctxt "@info"
msgid "The wallet that stores passwords on this PC didn't answer."
msgstr "Le portefeuille qui garde les mots de passe de ce PC n'a pas répondu."

msgctxt "@info"
msgid "No web browser found"
msgstr "Aucun navigateur trouvé"

msgctxt "@info"
msgid "Install a web browser to sign in."
msgstr "Installez un navigateur pour vous connecter."

msgctxt "@info"
msgid "Raye account isn't installed"
msgstr "Le compte Raye n'est pas installé"

msgctxt "@info"
msgid "Install updates, then try again."
msgstr "Installez les mises à jour, puis réessayez."

msgctxt "@info"
msgid "Couldn't change your picture or name on this PC"
msgstr "Impossible de changer votre image ou votre nom sur ce PC"

msgctxt "@info"
msgid "Try again from Your info."
msgstr "Réessayez depuis Vos informations."

msgctxt "@info"
msgid "This picture is too big"
msgstr "Cette image est trop lourde"

msgctxt "@info"
msgid "Choose a picture under 2 MB."
msgstr "Choisissez une image de moins de 2 Mo."

msgctxt "@info"
msgid "Already signing in"
msgstr "Connexion déjà en cours"

msgctxt "@info"
msgid "Finish in your browser, or cancel and start again."
msgstr "Terminez dans votre navigateur, ou annulez et recommencez."

msgctxt "@info"
msgid "Something went wrong"
msgstr "Un problème est survenu"

msgctxt "@info"
msgid "Try again in a few minutes."
msgstr "Réessayez dans quelques minutes."

