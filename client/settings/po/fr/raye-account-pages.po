msgid "Syncing your settings"
msgstr "Synchronisation de vos paramètres"

msgctxt "@info"
msgid "Sign in or create your account on the page that just opened. New account? Open the link in the email we send, then sign in on that same page."
msgstr "Connectez-vous ou créez votre compte sur la page qui vient de s'ouvrir. Nouveau compte ? Ouvrez le lien du courriel que nous vous envoyons, puis connectez-vous sur cette même page."

msgctxt "@info"
msgid "Your settings and picture are going to your Raye account. This takes a few seconds."
msgstr "Vos paramètres et votre photo partent vers votre compte Raye. Cela prend quelques secondes."

msgctxt "@label"
msgid "Which settings do you want to keep?"
msgstr "Quels paramètres voulez-vous garder ?"

msgctxt "@title:window"
msgid "Which settings do you want to keep?"
msgstr "Quels paramètres voulez-vous garder ?"

msgctxt "@info"
msgid "Your Raye account already has settings, and %1 is different on this PC."
msgid_plural "Your Raye account already has settings, and %1 are different on this PC."
msgstr[0] "Votre compte Raye a déjà des paramètres, et %1 est différent sur ce PC."
msgstr[1] "Votre compte Raye a déjà des paramètres, et %1 sont différents sur ce PC."

msgctxt "@info"
msgid "Your Raye account already has settings from another PC, and %1 of them is different here. Keep this PC's and they go to your account, or use your account's and this PC changes to match. Your picture goes with the choice."
msgid_plural "Your Raye account already has settings from another PC, and %1 of them are different here. Keep this PC's and they go to your account, or use your account's and this PC changes to match. Your picture goes with the choice."
msgstr[0] "Votre compte Raye a déjà les paramètres d'un autre PC, et %1 est différent ici. Gardez ceux de ce PC et ils partent vers votre compte, ou utilisez ceux du compte et ce PC s'aligne dessus. Votre photo suit le même choix."
msgstr[1] "Votre compte Raye a déjà les paramètres d'un autre PC, et %1 sont différents ici. Gardez ceux de ce PC et ils partent vers votre compte, ou utilisez ceux du compte et ce PC s'aligne dessus. Votre photo suit le même choix."

