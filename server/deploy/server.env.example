RAYE_ACCOUNT_DATABASE_URL=postgres://raye_account@localhost/raye_account?host=/run/postgresql

# Required. What the links in mail point at, so it has to be the address
# people reach from outside, not the listen address. https, or loopback for
# local work: a password-reset token over plain http is handed to the
# network. The server refuses to start without it.
RAYE_ACCOUNT_BASE_URL=https://account.rayelinux.com

RAYE_ACCOUNT_LISTEN=0.0.0.0:8787
# only behind the Cloudflare tunnel, where the peer is always the connector
RAYE_ACCOUNT_TRUST_PROXY=1
RAYE_ACCOUNT_HTTPS=1
RAYE_ACCOUNT_LOG=info

# Where mail goes. Unset, NOTHING IS SENT: letters go to an in-memory
# outbox, which is right for a developer's machine and wrong in production --
# address confirmation and password reset would reach nobody, and the only
# sign is one WARN at startup. There is no SMTP password here and none is
# wanted: the local binary is already configured to relay.
RAYE_ACCOUNT_SENDMAIL=/usr/sbin/sendmail
RAYE_ACCOUNT_MAIL_FROM=bonjour@rayelinux.com

# Seals every TOTP secret at rest. 32 bytes as base64url without padding:
#   head -c 32 /dev/urandom | basenc --base64url | tr -d '='
#
# Unset, two-step verification is REFUSED rather than run on a key invented
# at startup -- such a key stops opening the stored secrets at the next
# restart, and people would find out only when they next needed it.
#
# 🚨 Losing or changing this key makes every enrolled second factor
# unopenable; those accounts get in with a recovery code and must enrol
# again. Keep it with the other things that are not in git, and note it
# outside the lab, like the restic password.
RAYE_ACCOUNT_TOTP_KEY=
